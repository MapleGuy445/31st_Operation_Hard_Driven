											class Attributes
											{
												init="this addAction [""Spawn D-77 Pelican"", {        " \n "_pos = [(getPosATL  spawn_pos_2) # 0, (getPosATL  spawn_pos_2) # 1, (getPosATL  spawn_pos_2) #2 + 0.5];        " \n "_vehicle = createVehicle [""31stPelican"", _pos,[],0,""NONE""];        " \n "_vehicle setVehicleReportRemoteTargets true;        " \n "_vehicle setVehicleReportOwnPosition true;       " \n "_vehicle setvehicleReceiveRemoteTargets true;      " \n "{ _x addCuratorEditableObjects [[_vehicle], true] } forEach allCurators;        " \n "_vehicle setDir (getDir  spawn_pos_2);        " \n "}];       " \n "      " \n "this addAction [""Spawn Falcon"", {        " \n "_pos = [(getPosATL  spawn_pos_2) # 0, (getPosATL  spawn_pos_2) # 1, (getPosATL  spawn_pos_2) #2 + 0.5];        " \n "_vehicle = createVehicle [""31stFalcon"", _pos,[],0,""NONE""];        " \n "_vehicle setVehicleReportRemoteTargets true;        " \n "_vehicle setVehicleReportOwnPosition true;       " \n "_vehicle setvehicleReceiveRemoteTargets true;      " \n "{ _x addCuratorEditableObjects [[_vehicle], true] } forEach allCurators;        " \n "_vehicle setDir (getDir  spawn_pos_2);        " \n "}];       " \n "      " \n "this addAction [""Spawn Hornet"", {        " \n "_pos = [(getPosATL  spawn_pos_2) # 0, (getPosATL  spawn_pos_2) # 1, (getPosATL  spawn_pos_2) #2 + 0.5];        " \n "_vehicle = createVehicle [""31stHornet"", _pos,[],0,""NONE""];        " \n "_vehicle setVehicleReportRemoteTargets true;        " \n "_vehicle setVehicleReportOwnPosition true;       " \n "_vehicle setvehicleReceiveRemoteTargets true;      " \n "{ _x addCuratorEditableObjects [[_vehicle], true] } forEach allCurators;        " \n "_vehicle setDir (getDir  spawn_pos_2);        " \n "}];      " \n "      " \n "this addAction [""Spawn F29 Nando"", {        " \n "_pos = [(getPosATL  spawn_pos_2) # 0, (getPosATL  spawn_pos_2) # 1, (getPosATL  spawn_pos_2) #2 + 0.5];        " \n "_vehicle = createVehicle [""31stF29"", _pos,[],0,""NONE""];        " \n "_vehicle setVehicleReportRemoteTargets true;        " \n "_vehicle setVehicleReportOwnPosition true;       " \n "_vehicle setvehicleReceiveRemoteTargets true;      " \n "{ _x addCuratorEditableObjects [[_vehicle], true] } forEach allCurators;        " \n "_vehicle setDir (getDir  spawn_pos_2);        " \n "}]; ";
